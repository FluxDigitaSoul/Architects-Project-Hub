# Copia questo file in `.env` (ignorato da git) e compila i valori.
# Non inserire MAI credenziali reali in questo file.

# --- API ---
NODE_ENV=development
PORT=3000
# Proxy fidati davanti all'API (0 in locale; in produzione di solito 2: Vercel + bilanciatore)
TRUST_PROXY=0
LOG_LEVEL=info
# Dominio base della piattaforma: i tenant sono {slug}.{PLATFORM_BASE_DOMAIN}
PLATFORM_BASE_DOMAIN=localhost
# Origini ammesse per CORS (separate da virgola)
CORS_ORIGINS=http://localhost:4200

# --- Database (Supabase Postgres) ---
# Connessione dell'API con il ruolo applicativo `app_api` (NON postgres, NON service_role).
# Con Supabase usare il pooler in modalità "transaction" (porta 6543).
DATABASE_URL=postgresql://app_api.YOUR-PROJECT-REF:CHANGE_ME@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# true = verifica il certificato TLS del pooler (richiede il CA di Supabase)
DATABASE_SSL_STRICT=false

# --- Supabase Auth (ADR-003) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Endpoint JWKS per verificare i JWT degli utenti dello studio
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
# Chiavi del progetto (Settings > API keys). La secret serve solo al backend e ai test e2e.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CHANGE_ME
SUPABASE_SECRET_KEY=sb_secret_CHANGE_ME

# --- Storage file (temporaneo: Supabase Storage al posto di S3, vedi ROADMAP) ---
STORAGE_BUCKET=project-files

# --- Email e link ---
# URL pubblico dell'interfaccia: base dei link nelle email (portale, revisione, documenti)
APP_BASE_URL=http://localhost:4200
# log = le email si scrivono nel log dell'API (solo sviluppo); resend = invio reale
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=notifiche@example.com

# --- Automazione (job pianificati, AFU cap. 14.3) ---
# on = l'API esegue da sola notifiche raggruppate (ogni 2 min), promemoria di revisione (08:00)
# e conservazione dei dati (03:30). Sicuro anche con più istanze (lease su app.job_runs).
JOBS_SCHEDULER=on
# Facoltativo: abilita POST /api/v1/internal/jobs/:name per uno scheduler esterno
# (Authorization: Bearer <JOBS_SECRET>, almeno 32 caratteri). Vuoto = endpoint disattivato.
JOBS_SECRET=

# --- Test d'integrazione del database (db-tests) ---
# Postgres locale di test avviato con `npm run db:start` (superuser, solo in locale/CI)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54340/postgres
